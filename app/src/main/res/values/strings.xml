    <string name="charon_service_label">Obol · Charon</string>
    <string name="charon_service_description">Charon sees which app or site is on the screen. Time in the apps of your patrons earns obols, and the feeds you named as streams of Lethe ask for a fare. Nothing leaves the phone: no internet, no account, no analytics.</string>

